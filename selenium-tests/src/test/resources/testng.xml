<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Moobius Test Suite" parallel="false">

    <listeners>
        <listener class-name="utils.ScreenshotListener"/>
    </listeners>

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.AccountTest"/>
            <class name="tests.HomePageTest"/>
            <class name="tests.NavigationTest"/>
            <class name="tests.BooksTest"/>
            <class name="tests.ProductTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.AccountTest"/>
            <class name="tests.HomePageTest"/>
            <class name="tests.NavigationTest"/>
            <class name="tests.BooksTest"/>
            <class name="tests.ProductTest"/>
        </classes>
    </test>

</suite>
